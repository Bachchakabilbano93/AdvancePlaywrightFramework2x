{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@api/*": [
        "src/api/*"
      ],
      "@config/*": [
        "src/config/*"
      ],
      "@fixtures/*": [
        "src/fixtures/*"
      ],
      "@testdata/*": [
        "src/testdata/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@tests/*": [
        "./src/tests/*"
      ],
      "@pages/*": [
        "src/pages/*"
      ]
    },
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": [
    "src",
    "playwright.config.ts"
  ]
}